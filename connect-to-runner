set -euo pipefail

# Ensure both parameters are provided
if [ "$#" -lt 2 ]; then
   echo "Usage: $0 <proxy_user@proxy_machine> <workflow_file.yaml>"
   echo "Example: $0 user@192.168.1.50 debug-tailscale-ubuntu.yaml"
   exit 1
fi
PROXY_SSH=$1
WORKFLOW_FILE=$2

# Extract the repository name from the local git remote:
REPO_NAME=$(basename -s .git "$(git config --get remote.origin.url)")

# Determine the OS string and the correct SSH user:
if [[ "${WORKFLOW_FILE}" == *"windows"* ]]; then
   RUNNER_OS="Windows"
   SSH_USER="runneradmin"
elif [[ "${WORKFLOW_FILE}" == *"macos"* ]]; then
   RUNNER_OS="macOS"
   SSH_USER="runner"
else
   RUNNER_OS="Linux"
   SSH_USER="runner"
fi

# Construct the expected Tailscale hostname:
TS_HOSTNAME="${REPO_NAME}-${RUNNER_OS}"

# Check if the workflow is already running:
echo "Checking if ${WORKFLOW_FILE} is already running ..."
RUNNING_ID="$(gh run list --workflow "${WORKFLOW_FILE}" --status in_progress --json databaseId --jq '.[0].databaseId')"

if [ -z "${RUNNING_ID}" ]; then
   echo "Workflow is not running. Triggering ${WORKFLOW_FILE} ..."
   gh workflow run "${WORKFLOW_FILE}"
else
   echo "Workflow is already running (Run ID: ${RUNNING_ID}). Skipping trigger."
fi

echo "Waiting for ${TS_HOSTNAME} to become online via proxy (${PROXY_SSH}) ..."

# Continuously ping the Tailscale hostname from the remote machine until it responds
while true ; do
   if ssh "${PROXY_SSH}" tailscale ping -c 1 --timeout 2s "${TS_HOSTNAME}" >/dev/null 2>&1 ; then
      IPV4="$(ssh "${PROXY_SSH}" tailscale ip -4 "${TS_HOSTNAME}")"
      echo -e "\n========================================================="
      echo "✅ Runner is online!"
      echo "Tailscale IP: ${IPV4}"
      echo "Connect via ProxyJump from your local machine:"
      echo "ssh -J ${PROXY_SSH} ${SSH_USER}@${TS_HOSTNAME}"
      echo ""
      echo "Or connect directly from the proxy machine:"
      echo "ssh ${SSH_USER}@${TS_HOSTNAME}"
      echo "========================================================="
      break
   fi

   echo -n "."
   sleep 10
done
